# ServiceDesk - Environment Variables
# Copy from .env.example and fill in your values

SECRET_KEY=django-insecure-servicedesk-dev-key-change-in-production-abc123xyz
DEBUG=True
DJANGO_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (MySQL) - Update with your MySQL credentials
DB_NAME=servicedesk_db
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306

# Email (console backend for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ServiceDesk <noreply@servicedesk.com>

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Frontend URL
FRONTEND_URL=http://localhost:5173

# File Upload
MAX_UPLOAD_SIZE_MB=10
