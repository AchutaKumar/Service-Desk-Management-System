# ServiceDesk Backend - Environment Variables Example
# Copy this file to .env and fill in your values

# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Django Environment (development uses SQLite, production uses MySQL or DATABASE_URL)
DJANGO_ENV=development

# Database (Production / Vercel: Neon, Supabase, Railway PostgreSQL)
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/servicedesk?sslmode=require

# Database (MySQL alternative)
DB_NAME=servicedesk_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# Email (Development - console backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=ServiceDesk <noreply@servicedesk.com>

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Frontend URL (for password reset emails)
FRONTEND_URL=http://localhost:5173

# File Upload
MAX_UPLOAD_SIZE_MB=10
