# ServiceDesk Backend - Environment Variables Example
# Copy this file to .env and fill in your values

# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Django Environment
DJANGO_ENV=development

# Database (MySQL - Local or Aiven Managed Cloud)
DB_NAME=servicedesk_db
DB_USER=avnadmin
DB_PASSWORD=your_aiven_or_local_password
DB_HOST=mysql-xxxx.aivencloud.com
DB_PORT=10610

# Cloud Database URL (used on Vercel or Production)
# DATABASE_URL=mysql://avnadmin:your_password@mysql-xxxx.aivencloud.com:10610/servicedesk_db

# Optional: Set to True to use SQLite instead of MySQL
# USE_SQLITE=False

# Email (Development - console backend)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=ServiceDesk <noreply@servicedesk.com>

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Frontend URL (for password reset emails)
FRONTEND_URL=http://localhost:5173

# File Upload
MAX_UPLOAD_SIZE_MB=10
